set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY spi_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 24.1STD.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "15:00:29  OCTOBER 02, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "24.1std.0 Lite Edition"
set_global_assignment -name SYSTEMVERILOG_FILE testbench/wrapper/spi_dut.sv
set_global_assignment -name SYSTEMVERILOG_FILE testbench/top/spi_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE pkg/state_control.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/interface/spi_bus_if.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/slaver_receiver.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/master_send.sv
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name EDA_SIMULATION_TOOL "Questa Intel FPGA (SystemVerilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "SYSTEMVERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_timing
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_symbol
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_signal_integrity
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_boundary_scan
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_location_assignment PIN_A8 -to done
set_location_assignment PIN_A9 -to miso
set_location_assignment PIN_A10 -to mosi
set_location_assignment PIN_C10 -to reset_n
set_location_assignment PIN_B10 -to sck
set_location_assignment PIN_D13 -to ss
set_location_assignment PIN_C11 -to start
set_location_assignment PIN_C14 -to data_received[0]
set_location_assignment PIN_E15 -to data_received[1]
set_location_assignment PIN_C15 -to data_received[2]
set_location_assignment PIN_C16 -to data_received[3]
set_location_assignment PIN_E16 -to data_received[4]
set_location_assignment PIN_D17 -to data_received[5]
set_location_assignment PIN_C17 -to data_received[6]
set_location_assignment PIN_P11 -to clk
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top